pipeline {
    agent any

    stages {
        stage('Run Tests') {
            steps {
                bat 'npm ci'
                bat 'npm run practice'
            }
        }
    }

    post {
        always {
            bat 'echo Test execution completed > build-info.txt'

            bat '''
                powershell -NoProfile -Command "if (Test-Path 'allure-results') { Compress-Archive -Path 'allure-results' -DestinationPath 'allure-results.zip' -Force } else { Write-Host 'WARNING: allure-results directory not found' }"
            '''

            archiveArtifacts(
                artifacts: 'build-info.txt,allure-results.zip,allure-results/**',
                allowEmptyArchive: true,
                fingerprint: true
            )

            build job: 'Allure-Report',
                wait: false,
                propagate: false
        }
    }
}
