pipeline {
    agent any 
    
    stages {
        stage('Run Tests') {
            steps {
                bat 'npm ci'
                bat 'npm run practice'
            }
        }
    }
    
    post {
        always {
            bat 'echo Test execution completed > build-info.txt'

            archiveArtifacts(
                artifacts: 'build-info.txt',
                fingerprint: true
            )

            build job: 'Allure-Report',
                wait: false,
                propagate: false
        }
    }
}