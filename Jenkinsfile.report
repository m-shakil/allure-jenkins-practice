pipeline {
    agent any
    
    stages {
        stage('Copy Test Result') {
            steps {
                copyArtifacts(
                    projectName: 'Allure-Test',
                    selector: lastComplete(),
                    filter: 'allure-results/**'
                )
            }
        }
    }
    
    stage('Verify') {
        stage {
            bat 'dir allure-results'
        }
    }

    stage('Verify') {
        stage {
            allure {
                commandline: 'Allure',
                includeProperties: false,
                jdk: '',
                resultPolicy: 'LEAVE_AS_IS',
                results: [[path: 'allure-results']]
            }
        }
    }
}