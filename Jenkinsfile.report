pipeline {
    agent any

    stages {
        stage('Copy Test Result') {
            steps {
                copyArtifacts(
                    projectName: 'Allure-Test',
                    selector: specific('6'),
                    filter: 'build-info.txt'
                )
            }
        }

        stage('Verify Artifact') {
            steps {
                bat 'dir'
                bat 'type build-info.txt'
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished!'
        }

        success {
            echo 'Build was successful!'
        }

        failure {
            echo 'Build failed!'
        }
    }
}
